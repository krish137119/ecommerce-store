NODE_ENV=development
PORT=5000

# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/shopEasy

# Auth — use a long random string: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Initial admin (seeded into MongoDB on first boot)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@shopeasy.com
ADMIN_PASSWORD=ChangeMe@123

# Set to true only when serving over HTTPS (production)
COOKIE_SECURE=false

# Seed demo products on boot while the products collection is empty
SEED_PRODUCTS=true

# Currency & shipping (INR by default)
CURRENCY=INR
SHIPPING_FEE=49
FREE_SHIPPING_THRESHOLD=999

# Razorpay (Indian payment gateway) — get test keys at https://dashboard.razorpay.com
# Leave both empty to skip online payments (orders are created directly)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Brevo Email OTP (free — 300 emails/day, no domain needed). Get a key at
# https://brevo.com → Settings → API Keys → "SMTP API key". Verify your sender email at Senders → Create a Sender.
# Sends to any recipient from your verified email. Without a key, OTP stays simulated (dev fallback):
# the code is logged to the server console.
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=ShopEasy
